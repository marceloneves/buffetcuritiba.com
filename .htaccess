# ==========================================================================
# Buffet Curitiba — site estático (HTML/CSS/JS)
# ==========================================================================

# Evita listagem de diretórios
Options -Indexes

# ---------------------------------------------------------------------
# HTTPS + www -> non-www (URLs canônicas usam https://buffetcuritiba.com)
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Remove ".html" e "index.html" da URL, mantendo as pastas "bonitas"
  RewriteCond %{THE_REQUEST} /index\.html[?\s] [NC]
  RewriteRule ^(.*?)index\.html$ /$1 [R=301,L]

  RewriteCond %{THE_REQUEST} /([^.\s]+)\.html[?\s] [NC]
  RewriteRule ^(.*)\.html$ /$1 [R=301,L]

  # Serve o .html correspondente sem exigir a extensão na URL
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Endpoints antigos do WordPress não existem mais neste site estático
  RewriteRule ^wp-admin(/.*)?$ / [R=301,L]
  RewriteRule ^wp-login\.php$ / [R=301,L]
  RewriteRule ^wp-json(/.*)?$ / [R=301,L]
  RewriteRule ^xmlrpc\.php$ / [R=301,L]
  RewriteRule ^feed(/.*)?$ / [R=301,L]

  # favicon.ico solicitado por padrão pelos navegadores
  RewriteRule ^favicon\.ico$ /assets/uploads/2025/10/cropped-site-fav-icon-32x32.webp [L]
</IfModule>

# ---------------------------------------------------------------------
# Página de erro 404
# ---------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# Tipos MIME corretos
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/xml .xml
</IfModule>

# ---------------------------------------------------------------------
# Compressão (gzip/deflate)
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff font/woff2 font/ttf font/eot
</IfModule>

# ---------------------------------------------------------------------
# Cache do navegador
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------------
# Cabeçalhos de segurança
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------
# Bloqueia acesso a arquivos internos (backups, configs, etc.)
# ---------------------------------------------------------------------
<FilesMatch "\.(bak|log|sql|zip|env)$">
  Require all denied
</FilesMatch>
